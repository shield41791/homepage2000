{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/core/**",
              "components/grid/**",
              "components/nav/**",
              "components/widgets/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nanum Gothic|Nanum Myeongjo|Comic Neue))/i]",
        "message": "Font not provided by the design system. Available: Nanum Gothic, Nanum Myeongjo, Comic Neue."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|domain|onLogoClick|mobile|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: title, domain, onLogoClick, mobile."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardPost'] > JSXAttribute > JSXIdentifier[name!=/^(?:no|title|author|date|views|isNew|onClick|key|ref|className|style|children)$/]",
        "message": "<BoardPost> doesn't accept that prop. Declared props: no, title, author, date, views, isNew, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|isNew|onClick|key|ref|className|style|children)$/]",
        "message": "<CategoryTab> doesn't accept that prop. Declared props: label, active, isNew, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='EffectSettingsPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:effect|onEffectChange|reduceMotion|onToggleReduceMotion|onClose|options|key|ref|className|style|children)$/]",
        "message": "<EffectSettingsPanel> doesn't accept that prop. Declared props: effect, onEffectChange, reduceMotion, onToggleReduceMotion, onClose, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnterGate'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onEnter|today|total|since|copyright|key|ref|className|style|children)$/]",
        "message": "<EnterGate> doesn't accept that prop. Declared props: title, subtitle, onEnter, today, total, since, copyright."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterPlayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:trackLabel|playing|muted|onTogglePlay|onToggleMute|onToggleSettings|copyright|mobile|key|ref|className|style|children)$/]",
        "message": "<FooterPlayer> doesn't accept that prop. Declared props: trackLabel, playing, muted, onTogglePlay, onToggleMute, onToggleSettings, copyright, mobile."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|headerRight|accent|double|padded|children|style|key|ref|className|style|children)$/]",
        "message": "<Frame> doesn't accept that prop. Declared props: header, headerRight, accent, double, padded, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:blue|green)$/]",
        "message": "<Frame> accent must be one of 'blue' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LCDCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:today|total|key|ref|className|style|children)$/]",
        "message": "<LCDCounter> doesn't accept that prop. Declared props: today, total."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|dotted|speed|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: text, dotted, speed."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:show|label|key|ref|className|style|children)$/]",
        "message": "<NewBadge> doesn't accept that prop. Declared props: show, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|total|onChange|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, total, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|thumb|isNew|onClick|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: title, thumb, isNew, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|author|date|views|content|onBack|key|ref|className|style|children)$/]",
        "message": "<PostDetail> doesn't accept that prop. Declared props: title, author, date, views, content, onBack."
      },
      {
        "selector": "JSXOpeningElement[name.name='Project'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tagline|host|url|thumb|isNew|key|ref|className|style|children)$/]",
        "message": "<Project> doesn't accept that prop. Declared props: title, tagline, host, url, thumb, isNew."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|isNew|onClick|key|ref|className|style|children)$/]",
        "message": "<SidebarMenuItem> doesn't accept that prop. Declared props: label, active, isNew, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Video'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|desc|thumb|isNew|onClick|key|ref|className|style|children)$/]",
        "message": "<Video> doesn't accept that prop. Declared props: title, desc, thumb, isNew, onClick."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
